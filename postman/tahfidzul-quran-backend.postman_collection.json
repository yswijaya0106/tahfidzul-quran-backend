        {
          "name": "Student dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/dashboard/students/{{studentId}}?from=2026-01-01&to=2026-12-31&timezone=Asia/Jakarta",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "students", "{{studentId}}"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
