    {
      "name": "Assessments",
      "item": [
        {
          "name": "List assessments for student",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/students/{{studentId}}/assessments?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["students", "{{studentId}}", "assessments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "assessmentType", "value": "NEW_MEMORIZATION", "disabled": true },
                { "key": "dateFrom", "value": "2026-01-01", "disabled": true },
                { "key": "dateTo", "value": "2026-12-31", "disabled": true }
              ]
            },
            "description": "Admin or an operator assigned to the student's location."
          }
        },
        {
          "name": "Create assessment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('assessmentId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessmentDate\": \"2026-01-15T00:00:00.000Z\",\n  \"assessmentType\": \"NEW_MEMORIZATION\",\n  \"startSurahNumber\": 1,\n  \"startVerseNumber\": 1,\n  \"endSurahNumber\": 1,\n  \"endVerseNumber\": 7,\n  \"grade\": \"MUMTAZ\",\n  \"notes\": \"Bacaan lancar, tajwid baik.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students/{{studentId}}/assessments",
              "host": ["{{baseUrl}}"],
              "path": ["students", "{{studentId}}", "assessments"]
            },
            "description": "surahNumber must be 1-114; verseNumber must not exceed the surah's verse count; end position must not precede the start position; assessmentDate cannot be further in the future than the configured clock-skew window."
          }
        },
        {
          "name": "Get assessment by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/assessments/{{assessmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["assessments", "{{assessmentId}}"]
            }
          }
        },
        {
          "name": "Update assessment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grade\": \"JAYYID_JIDDAN\",\n  \"notes\": \"Perlu perbaikan makhraj sedikit.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assessments/{{assessmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["assessments", "{{assessmentId}}"]
            },
            "description": "Creates a revision/audit event; never silently overwrites the prior value."
          }
        },
        {
          "name": "Archive (delete) assessment",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/assessments/{{assessmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["assessments", "{{assessmentId}}"]
            },
            "description": "Soft-delete with an audit event; admin or the assigned operator."
          }
        }
      ]
    },
    {
