          "name": "List all surahs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/quran/surahs",
              "host": ["{{baseUrl}}"],
              "path": ["quran", "surahs"]
            },
            "description": "Returns all 114 surahs ordered by surahNumber, with arabicName/latinName/verseCount."
          }
        },
        {
          "name": "Get surah by number",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/quran/surahs/1",
              "host": ["{{baseUrl}}"],
              "path": ["quran", "surahs", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "List locations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/locations?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["locations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "status", "value": "ACTIVE", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('locationId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cabang Al-Hisan Pusat\",\n  \"address\": \"Jl. Pendidikan No. 1, Jakarta\",\n  \"latitude\": -6.2,\n  \"longitude\": 106.816666,\n  \"phone\": \"+6281234567890\",\n  \"description\": \"Cabang utama\",\n  \"organizationMembers\": [\n    { \"name\": \"Ust. Fulan\", \"roleTitle\": \"Kepala Cabang\", \"phone\": \"+6281200000000\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/locations",
              "host": ["{{baseUrl}}"],
              "path": ["locations"]
            },
            "description": "Admin only. Rejects a duplicate active location name (409)."
          }
        },
        {
          "name": "Get location by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["locations", "{{locationId}}"]
            }
          }
        },
        {
          "name": "Update location",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Cabang utama (updated)\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["locations", "{{locationId}}"]
            }
          }
        },
        {
          "name": "Delete (soft) location",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["locations", "{{locationId}}"]
            }
          }
        }
      ]
    },
