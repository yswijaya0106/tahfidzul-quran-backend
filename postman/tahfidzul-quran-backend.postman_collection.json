              "raw": "{{baseUrl}}/students?page=1&pageSize=20&locationId={{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["students"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "locationId", "value": "{{locationId}}" },
                { "key": "name", "value": "", "disabled": true },
                { "key": "studentCode", "value": "", "disabled": true },
                { "key": "phone", "value": "", "disabled": true },
                { "key": "status", "value": "ACTIVE", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
