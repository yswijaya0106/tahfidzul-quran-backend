    {
      "name": "Files",
      "item": [
        {
          "name": "Presign upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('objectKey', pm.response.json().data.objectKey);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"activity-photo.jpg\",\n  \"mimeType\": \"image/jpeg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/files/presign",
              "host": ["{{baseUrl}}"],
              "path": ["files", "presign"]
            },
            "description": "Returns a short-lived signed uploadUrl and objectKey. Upload the file bytes directly to uploadUrl (PUT) with the same mimeType, then call Complete below."
          }
        },
        {
          "name": "Complete upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Safe to retry with the same key if the request times out."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objectKey\": \"{{objectKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/files/{{objectKey}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{objectKey}}", "complete"]
            },
            "description": "Verifies the object was actually uploaded (size/MIME type) before it is referenced elsewhere (e.g. activity photos)."
          }
        }
      ]
    }
  ]
}
