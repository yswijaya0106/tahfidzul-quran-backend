{
  "info": {
    "_postman_id": "495e0de8-4b59-4ce5-ae63-a0f9091de818",
    "name": "Tahfidz Quran Backend API",
    "description": "REST API for the Tahfidz Quran system (see README.md). Run \"Auth > Login\" first — it stores accessToken/refreshToken as collection variables that every other request reuses via Bearer auth. Most \"create\" requests auto-capture the returned id into a collection variable (locationId, studentId, assessmentId, activityId, userId) for the requests that follow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fails fast on any 5xx so contract breaks are obvious in the runner.",
          "pm.test('no server error', function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "adminIdentifier", "value": "admin@example.com", "type": "string" },
    { "key": "adminPassword", "value": "StrongPassw0rd!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "locationId", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" },
    { "key": "assessmentId", "value": "", "type": "string" },
    { "key": "activityId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "objectKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{adminIdentifier}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with phone number or email plus password. Returns a generic 401 for any invalid identifier/password so account existence is never revealed."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotates the refresh token: the presented token is revoked and a new access/refresh pair is issued."
          }
        },
        {
          "name": "Logout (current device)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout-all"]
            }
          }
        }
      ]
    },
    {
      "name": "Quran",
      "item": [
