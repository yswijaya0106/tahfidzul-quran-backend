{
  "name": "tahfidzul-quran-backend",
  "version": "0.1.0",
  "description": "Tahfidz Quran backend API (Node.js, TypeScript, Fastify, MySQL)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/infrastructure/db/migrate.ts",
    "seed:admin": "tsx src/infrastructure/db/seedAdmin.ts",
    "seed:dummy": "tsx src/infrastructure/db/seedDummyData.ts",
    "seed:future-assessments": "tsx src/infrastructure/db/seedFutureAssessments.ts",
    "seed:future-activities": "tsx src/infrastructure/db/seedFutureActivities.ts",
    "seed:angkatan": "tsx src/infrastructure/db/seedAngkatan.ts",
    "backfill:activity-photo-urls": "tsx src/infrastructure/db/backfillFakeActivityPhotoUrls.ts",
    "rename:students-islamic": "tsx src/infrastructure/db/renameStudentsToIslamicNames.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
